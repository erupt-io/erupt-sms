<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>erupt-sms</artifactId>
    <name>Erupt : SMS</name>
    <description>erupt sms → SMS across vendors on SMS4J: channels, templates, sending with a log, verification codes and a blacklist, one channel picked in the header</description>
    <url>https://github.com/erupt-io/erupt-sms</url>

    <parent>
        <groupId>xyz.erupt</groupId>
        <artifactId>erupt</artifactId>
        <version>2.4.0</version>
    </parent>

    <properties>
        <sms4j.version>3.3.5</sms4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-data-jpa</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- The host application brings the erupt stack; here it also runs the standalone launcher -->
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-spring-boot-starter</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Every vendor SMS4J supports, configured from rows rather than files -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-javase-plugin</artifactId>
            <version>${sms4j.version}</version>
        </dependency>
        <!-- The zero-config database of the launcher, and of a host application that sets none -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A library: no repackaging, the plugin only serves `mvn spring-boot:run` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
